<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ backup & device-transfer rules. Mirrors backup_rules.xml. Spec §18.3. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="mediacache/" />
        <exclude domain="file" path="localthumbcache/" />
        <exclude domain="file" path="local-photo-library/" />
        <exclude domain="file" path="fallback/" />
        <exclude domain="file" path="diagnostics/" />
        <exclude domain="file" path="diagnostics-slides/" />
        <exclude domain="sharedpref" path="diagnostics_crash_envelope.xml" />
        <exclude domain="sharedpref" path="diagnostics_process_exit.xml" />
        <exclude domain="sharedpref" path="process_diagnostics.xml" />
        <exclude domain="sharedpref" path="diagnostics_identity.xml" />
        <exclude domain="sharedpref" path="runtime_breadcrumb_v1.xml" />
        <exclude domain="sharedpref" path="process_start_evidence.xml" />
        <exclude domain="sharedpref" path="memory_process_recovery.xml" />
        <exclude domain="sharedpref" path="battery_charge_protection.xml" />
        <exclude domain="sharedpref" path="foreground_intent.xml" />
        <exclude domain="database" path="frame.db" />
        <exclude domain="database" path="frame.db-wal" />
        <exclude domain="database" path="frame.db-shm" />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="mediacache/" />
        <exclude domain="file" path="localthumbcache/" />
        <exclude domain="file" path="local-photo-library/" />
        <exclude domain="file" path="fallback/" />
        <exclude domain="file" path="diagnostics/" />
        <exclude domain="file" path="diagnostics-slides/" />
        <exclude domain="sharedpref" path="diagnostics_crash_envelope.xml" />
        <exclude domain="sharedpref" path="diagnostics_process_exit.xml" />
        <exclude domain="sharedpref" path="process_diagnostics.xml" />
        <exclude domain="sharedpref" path="diagnostics_identity.xml" />
        <exclude domain="sharedpref" path="runtime_breadcrumb_v1.xml" />
        <exclude domain="sharedpref" path="process_start_evidence.xml" />
        <exclude domain="sharedpref" path="memory_process_recovery.xml" />
        <exclude domain="sharedpref" path="battery_charge_protection.xml" />
        <exclude domain="sharedpref" path="foreground_intent.xml" />
        <exclude domain="database" path="frame.db" />
        <exclude domain="database" path="frame.db-wal" />
        <exclude domain="database" path="frame.db-shm" />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
