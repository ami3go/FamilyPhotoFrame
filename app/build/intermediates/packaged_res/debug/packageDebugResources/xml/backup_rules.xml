<?xml version="1.0" encoding="utf-8"?>
<!--
  Legacy Auto Backup config (fullBackupContent, Android < 12). Spec §18.3:
  never back up private family-photo data, caches, thumbnails, diagnostics,
  or secrets. Phase 0 has no secrets/SMB cache yet, but the exclusions are
  declared now so later phases inherit a safe default.
-->
<full-backup-content>
    <exclude domain="file" path="media_cache/" />
    <exclude domain="file" path="fallback/" />
    <exclude domain="file" path="diagnostics/" />
    <exclude domain="sharedpref" path="diagnostics_crash_envelope.xml" />
    <exclude domain="sharedpref" path="diagnostics_process_exit.xml" />
    <exclude domain="sharedpref" path="process_diagnostics.xml" />
    <exclude domain="sharedpref" path="diagnostics_identity.xml" />
    <exclude domain="database" path="frame.db" />
    <exclude domain="database" path="frame.db-wal" />
    <exclude domain="database" path="frame.db-shm" />
    <exclude domain="cache" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
